{
  "private": true,
  "name": "sanity-gatsby-portfolio",
  "version": "2.0.0",
  "description": "Evan Allan Portfolio - Gatsby + Sanity",
  "workspaces": [
    "web",
    "studio"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace=web",
    "build:studio": "npm run build --workspace=studio",
    "build:all": "npm run build --workspaces",
    "dev": "npm run dev --workspace=web",
    "dev:studio": "npm run dev --workspace=studio",
    "clean": "npm run clean --workspace=web",
    "format": "npm run format --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "pre-deploy": "bash scripts/pre-deploy.sh",
    "deploy:graphql": "npm run deploy-graphql --workspace=studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {}
}
